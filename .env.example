QLOO_API_KEY=
USE_QLOO_MOCK=true
QLOO_BASE_URL=https://hackathon.api.qloo.com
OPENAI_API_KEY=
# Use one model that supports Responses API structured outputs for both branches.
# Set an exact model snapshot when available; no model is silently substituted.
OPENAI_MODEL=
AI_PROVIDER=openai
REPLICATE_API_TOKEN=
REPLICATE_MODEL=openai/gpt-4.1-mini
# Pin the version resolved from the model API, never silently upgrade between branches.
REPLICATE_VERSION=
